# ==============================================
# Production Environment Configuration
# ==============================================
# IMPORTANT: Copy this to .env.prod and fill in real values
# NEVER commit .env.prod to version control!
# ==============================================

# Environment identifier
ENV=production

# ==============================================
# PostgreSQL Database
# ==============================================
POSTGRES_USER=budgetcar_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=budgetcar_production
POSTGRES_PORT=5432

# ==============================================
# Backend API Server
# ==============================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Database connection string (use the Docker service name 'db' as host)
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# CORS - Comma-separated list of allowed origins
# Update with your actual production domain(s)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================
# JWT Authentication (CRITICAL - CHANGE THESE!)
# ==============================================
# Generate secure secrets with: openssl rand -hex 32
JWT_SECRET=GENERATE_A_SECURE_64_CHAR_HEX_STRING_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Refresh Tokens
USE_REFRESH_TOKENS=true
REFRESH_TOKEN_DAYS=30

# Password Reset
RESET_TOKEN_MINUTES=60
RESET_TOKEN_SECRET=GENERATE_ANOTHER_SECURE_64_CHAR_HEX_STRING_HERE

# ==============================================
# Frontend
# ==============================================
WEB_PORT=80
VITE_API_URL=https://api.yourdomain.com

# ==============================================
# Optional: Email Service (for password resets)
# ==============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=email_password_here
# SMTP_FROM=Budget CAR <noreply@yourdomain.com>

# ==============================================
# Optional: Monitoring & Logging
# ==============================================
# LOG_LEVEL=INFO
# SENTRY_DSN=https://xxx@sentry.io/xxx
